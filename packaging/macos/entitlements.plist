<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Hardened-runtime exceptions for cross-app binaries (Sprint 9, docs/packaging.md).

  Key names checked against Apple's documentation (Bundle Resources > Entitlements):
    com.apple.security.cs.allow-jit                        MAP_JIT writable+executable memory
    com.apple.security.cs.allow-unsigned-executable-memory W+X memory without MAP_JIT
    com.apple.security.cs.disable-library-validation       load code not signed by Apple or our Team ID

  They matter for binaries that run Windows code: Wine maps PE images as writable and
  executable memory and loads DXVK/MoltenVK/D3DMetal libraries that we did not sign.
  The `cross` launcher itself only spawns Wine, so these only take effect once Wine is
  shipped inside the signed bundle; today engines are downloaded at runtime and keep
  their own signatures. Unverified on a real Developer ID signature + notarization.
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<key>com.apple.security.cs.allow-unsigned-executable-memory</key>
	<true/>
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
